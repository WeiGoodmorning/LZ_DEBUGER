<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LZ"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="LZ.MainWindow"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        mc:Ignorable="d"
        Title="域控调试助手" Height="750" Width="1200"
        Icon="/assets/LZ_debugger.png">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="433*"/>
            <ColumnDefinition Width="167*"/>
        </Grid.ColumnDefinitions>
        <TabControl Style="{StaticResource TabControlCapsuleSolid}" Grid.ColumnSpan="2">
            <TabItem Header="连接">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="529*"/>
                        <ColumnDefinition Width="152*"/>
                        <ColumnDefinition Width="518*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Grid.ColumnSpan="2">
                        <TextBox x:Name ="server_ip" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left" Text ="192.168.1.210" hc:InfoElement.Title="域控IP" Width="150" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0"/>
                        <TextBox x:Name ="server_port" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left" Text ="8202" hc:InfoElement.Title="端口" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0"/>
                        <Button x:Name ="Connect_Button" Content="连接" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Connect_Button_Click"/>
                        <Button x:Name ="Restart_Button" Content="重启" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Restart_Button_Click"/>
                        <Button x:Name ="Update_Button" Content="更新程序" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Update_Button_Click"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,50" Grid.RowSpan="2">
                        <TextBox x:Name ="log_textbox" Margin="0,0,0,0" TextWrapping="Wrap" Width="800" Background="AliceBlue" BorderBrush="Black" BorderThickness="1"  />
                        <StackPanel Orientation="Vertical" >
                            <TextBox x:Name ="robot_type" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="域控版本" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="2">
                        <Button x:Name ="log_clear_button" Content="清除" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Click="log_clear_button_Click"/>
                        <Button x:Name ="log_save_button" Content="保存" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="log_save_button_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="50,0,0,0">
                            <CheckBox x:Name ="log_warning_checkbox" Content="Warning" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <CheckBox x:Name="log_info_checkbox" Content="Info" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>

            </TabItem>
            <TabItem Header="配置文件">
                <Grid>
                    <TabControl Style="{StaticResource TabControlCapsule}">
                        <TabItem Header="系统配置">
                            <Grid ShowGridLines="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"></RowDefinition>
                                    <RowDefinition Height="130"></RowDefinition>
                                    <RowDefinition Height="160"></RowDefinition>
                                    <RowDefinition Height="100"></RowDefinition>
                                    <RowDefinition ></RowDefinition>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="160,0,0,0">
                                    <Button x:Name="read_cfg" Style="{StaticResource ButtonPrimary}" Content="读取" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top"  Click="read_cfg_Click"/>
                                    <Button x:Name="write_cfg" Style="{StaticResource ButtonPrimary}" Content="写入" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top"  Click="write_cfg_Click"/>
                                    <Button x:Name="origin_cfg" Style="{StaticResource ButtonPrimary}" Content="还原默认参数" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top"  Click="origin_cfg_Click"/>

                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1" Margin="160,0,0,0">
                                    <GroupBox Width="256" Height="110" Header="机器人类型" hc:TitleElement.TitlePlacement="Top" Margin="20,0,0,0">
                                        <Grid>
                                            <RadioButton x:Name="config_rb_type_lz" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="立中" HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_type_siasun" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="新松" HorizontalAlignment="Left" Margin="10,35,0,0" VerticalAlignment="Top"/>
                                            <TextBox x:Name ="config_can_device_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="CAN接口" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,5,0,0"/>
                                            <TextBox x:Name ="config_can_baud_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="CAN速率" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,35,0,0"/>
                                        </Grid>
                                    </GroupBox>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Row="1" Margin="100,0,0,0">
                                        <TextBox x:Name="config_upper_ip_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="上位机IP" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                        <TextBox x:Name="config_upper_port_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="上位机端口" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" />
                                    </StackPanel>


                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"  Margin="160,0,0,0" Grid.Row="2">
                                    <GroupBox Header="VUT惯导" Width="256" Height="150" Margin="20,0,0,0">
                                        <Grid>
                                            <RadioButton x:Name="config_rb_instype_by" GroupName="VUT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="北云" HorizontalAlignment="Left" Width="50" Margin="20,0,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_instype_rt" GroupName="VUT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="RT" HorizontalAlignment="Left" Width="50" Margin="90,0,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_instype_shibo" GroupName="VUT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="shibo" HorizontalAlignment="Left" Width="60" Margin="165,0,0,0" VerticalAlignment="Top" />
                                            <TextBox x:Name ="config_ins_ip_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="IP" Width="125" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,40,0,0"/>
                                            <TextBox x:Name ="config_ins_port_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="PORT" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,40,0,0"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,85,0,0" VerticalAlignment="Top">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=config_rb_instype_by}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <RadioButton x:Name="config_rb_by_unicast" GroupName="VUT_MODE" Content="单播" />
                                                <RadioButton x:Name="config_rb_by_broadcast" GroupName="VUT_MODE" Content="广播" IsChecked="True" Margin="20,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="SPT惯导" Width="256" Height="150" Margin="20,0,20,0">
                                        <Grid>
                                            <RadioButton x:Name="config_rb_instype_by1" GroupName="SPT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="北云" HorizontalAlignment="Left" Width="50" Margin="20,0,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_instype_rt1" GroupName="SPT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="RT" HorizontalAlignment="Left" Width="50" Margin="90,0,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_instype_shibo1" GroupName="SPT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="shibo" HorizontalAlignment="Left" Width="60" Margin="165,0,0,0" VerticalAlignment="Top" />
                                            <TextBox x:Name ="config_ins_ip_textbox1" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="IP" Width="125" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,40,0,0"/>
                                            <TextBox x:Name ="config_ins_port_textbox1" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="PORT" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,40,0,0"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,85,0,0" VerticalAlignment="Top">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=config_rb_instype_by1}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <RadioButton x:Name="config_rb_by_unicast1" GroupName="SPT_MODE" Content="单播" />
                                                <RadioButton x:Name="config_rb_by_broadcast1" GroupName="SPT_MODE" Content="广播" IsChecked="True" Margin="20,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="VT惯导" Width="256" Height="150" Margin="0,0,0,0">
                                        <Grid>
                                            <RadioButton x:Name="config_rb_instype_by2" GroupName="VT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="北云" HorizontalAlignment="Left" Width="50" Margin="20,0,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_instype_rt2" GroupName="VT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="RT" HorizontalAlignment="Left" Width="50" Margin="90,0,0,0" VerticalAlignment="Top" />
                                            <RadioButton x:Name="config_rb_instype_shibo2" GroupName="VT_INS" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="shibo" HorizontalAlignment="Left" Width="60" Margin="165,0,0,0" VerticalAlignment="Top" />
                                            <TextBox x:Name ="config_ins_ip_textbox2" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="IP" Width="125" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,40,0,0"/>
                                            <TextBox x:Name ="config_ins_port_textbox2" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="PORT" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,40,0,0"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,85,0,0" VerticalAlignment="Top">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=config_rb_instype_by2}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <RadioButton x:Name="config_rb_by_unicast2" GroupName="VT_MODE" Content="单播" />
                                                <RadioButton x:Name="config_rb_by_broadcast2" GroupName="VT_MODE" Content="广播" IsChecked="True" Margin="20,0,0,0"/>

                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="160,0,0,0" Grid.Row="3">
                                    <GroupBox Grid.Row="1" Header="真值输出" hc:TitleElement.TitlePlacement="Top" Margin="20,0,0,0" Width="807">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="config_data_can_device_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="真值输出CAN接口" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                            <TextBox x:Name="config_data_can_baud_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="CAN速率" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                            <TextBlock Text="真值来源" ToolTip="选择平板表示直接转发平板真值，选择域控表示由域控计算相对数据真值" Style="{StaticResource TextBlockBoldBaseStyle}" hc:InfoElement.TitlePlacement="Left"  HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Center"/>
                                            <RadioButton x:Name="config_rb_robot" GroupName="DBC" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="域控" HorizontalAlignment="Left" Width="50" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <RadioButton x:Name="config_rb_ufo" GroupName="DBC" Background="{DynamicResource SecondaryRegionBrush}" Style="{StaticResource RadioButtonIcon}" Content="平板" HorizontalAlignment="Left" Width="50"  VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </GroupBox>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"  Margin="160,0,0,0" Grid.Row="4">
                                    <StackPanel Orientation="Vertical" Width="300" Margin="20,0,0,0">
                                        <TextBox x:Name ="config_smd_savedays_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="SMD保存天数" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>
                                        <TextBox x:Name="config_log_savedays_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="LOG保存天数" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>
                                        <TextBox x:Name="config_daq_can_device_textbox" ToolTip="数采设备连接的CAN口" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="数采输入CAN接口" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>

                                        <TextBox x:Name="config_headtraker_textbox" ToolTip="0表示从惯导读数据，1表示从平板接收数据" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="SPT数据来源" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0" />

                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Width="500">
                                        <TextBox x:Name ="config_smd_savepath_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="SMD保存路径" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>
                                        <TextBox x:Name ="config_log_savepath_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="LOG保存路径" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>
                                        <TextBox x:Name="config_daq_can_baud_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="数采输入CAN速率" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>
                                        <TextBox x:Name="config_save_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="Save_Mode" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"/>

                                    </StackPanel>
                                </StackPanel>


                            </Grid>
                        </TabItem>
                        <TabItem Header="参数配置">
                            <Grid ShowGridLines="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition ></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0">
                                    <Button x:Name ="Read_Control_Param_Button" Content="读取文件" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Read_Control_Param_Button_Click">
                                        <Button.Background>
                                            <LinearGradientBrush EndPoint="1,0">
                                                <GradientStop Color="#FF326CF3"/>
                                                <GradientStop Color="#FF326CF3" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name ="Temporary_Rread_Button" Content="临时读取" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Temporary_Rread_Button_Click">
                                        <Button.Background>
                                            <LinearGradientBrush EndPoint="1,0">
                                                <GradientStop Color="#FF326CF3"/>
                                                <GradientStop Color="#FF91B2FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name ="Write_Control_Param_Button" Content="写入文件" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Write_Control_Param_Button_Click"/>
                                    <Button x:Name ="Temporary_Write_Button" Content="临时修改" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Temporary_Write_Button_Click">
                                        <Button.Background>
                                            <LinearGradientBrush EndPoint="1,0">
                                                <GradientStop Color="#FF326CF3"/>
                                                <GradientStop Color="#FFA7C1FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name ="Calculate_COG_Button" Content="航向校准" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Click="Calculate_COG_Button_Click" >
                                        <Button.Background>
                                            <LinearGradientBrush EndPoint="1,0">
                                                <GradientStop Color="#FF326CF3"/>
                                                <GradientStop Color="SkyBlue" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <ProgressBar x:Name="COG_ProcessBar"  HorizontalAlignment="Left" Style="{StaticResource ProgressBarBaseStyle}" Height="20" Margin="20,0,0,0" VerticalAlignment="Center" Width="100"/>
                                    <TextBox x:Name="cog_estimated_textbox" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="COG"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Width="80"/>

                                </StackPanel>
                                <GroupBox Grid.Row="1" Header="横向控制" hc:TitleElement.TitlePlacement="Left" >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="400"></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <GroupBox Header="控制参数"  Style="{StaticResource GroupBoxTab.Small}" Margin="0,0,0,-15">
                                                <Grid ShowGridLines="True" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition></ColumnDefinition>
                                                        <ColumnDefinition></ColumnDefinition>
                                                        <ColumnDefinition></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Vertical" Grid.Column="0">
                                                        <TextBox x:Name="cfg_frobase" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="前轴长度"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_curve_kp1" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="KP1"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_curve_kp2" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="KP2"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_curve_kp3" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="KP3"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_ccrh_stanley" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="CCRH变道"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_elk_flag" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="ELK标志"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>

                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical" Grid.Column="1">
                                                        <TextBox x:Name="cfg_preview_point" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="预瞄点"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_lf_10" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="左转10"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_lf_20" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="左转20"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_lf_30" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="左转30"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_steer_limit" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="转角限幅"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>

                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical" Grid.Column="2">
                                                        <TextBox x:Name="cfg_heading_compen" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="航向补偿"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_rf_10" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="右转10"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_rf_20" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="右转20"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_reserve" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="预留"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>
                                                        <TextBox x:Name="cfg_speed_limit" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="转速限幅"  HorizontalAlignment="Left" Margin="0,10,0,0" Width="110"/>

                                                    </StackPanel>
                                                </Grid>

                                            </GroupBox>
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <GroupBox Header="临时变量">
                                                <Grid>
