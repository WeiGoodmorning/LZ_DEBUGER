                            <Grid ShowGridLines="True" Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="data_spt_azimuth1" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="方位角" Grid.Row="0" Width="130"/>
                                <TextBox x:Name="data_spt_forward_acc"  Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="前向加速度" Grid.Row="1" Width="130"/>

                            </Grid>
                            <Grid ShowGridLines="True" Grid.Column="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="data_spt_velocity1" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="速度" Grid.Row="0" Width="130"/>
                                <TextBox x:Name="data_spt_lateral_acc"  Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="横向加速度" Grid.Row="1" Width="130"/>

                            </Grid>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="VT"  Margin="0,20,0,0" Grid.Row="2">
                        <Grid ShowGridLines="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid ShowGridLines="True" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,0">
                                    <TextBlock Text="INS状态" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                    <ProgressBar Margin ="10" Style="{DynamicResource ProgressBarFlat}" Width="50" Height="15" Value="10" ></ProgressBar>
                                </StackPanel>
                            </Grid>
                            <Grid ShowGridLines="True" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,0">
                                    <TextBlock Text="差分状态" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <ProgressBar Margin ="10" Style="{DynamicResource ProgressBarFlat}" Width="50" Height="15" Value="10" ></ProgressBar>
                                </StackPanel>
                            </Grid>
                            <Grid ShowGridLines="True" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>

                                <TextBox  x:Name="data_vt_longitude" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="经度" Width="130"/>

                            </Grid>
                            <Grid ShowGridLines="True" Grid.Column="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="data_vt_latitude" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="纬度" Width="130"/>

                            </Grid>
                            <Grid ShowGridLines="True" Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="data_vt_azimuth" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="方位角" Width="130"/>

                            </Grid>
                            <Grid ShowGridLines="True" Grid.Column="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="data_vt_velocity" Style="{StaticResource TextBoxExtend}" hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.Title="速度" Width="130"/>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>

            </TabItem>
            <TabItem Header="轨迹" MouseLeftButtonUp="TabItem_MouseLeftButtonUp">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition ></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Button x:Name="Refresh_Track_Button" Style="{StaticResource ButtonPrimary}" Content="刷新轨迹" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" Grid.Row="0" Click="Refresh_Track_Button_Click_1"/>
                    </StackPanel>

                    <Canvas x:Name="TrackCanvas" Grid.Row="1" Margin="10,10,10,10" >
                        <Canvas.Background>
                            <ImageBrush ImageSource="/line.png" Stretch="Uniform"/>
                        </Canvas.Background>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="2">
                        <Grid Width="500">
                            <Label  Content="TTC：" HorizontalAlignment="Left" VerticalAlignment="Top"  FontSize="40" Height="74" Margin="10,0,0,0" Width="200"/>
                            <Label x:Name="Track_TTC"  HorizontalAlignment="Left" VerticalAlignment="Top"  FontSize="40" Height="74" Margin="210,0,0,0" Width="200"/>
                            <Label  Content="VEL：" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="40" Height="74" Margin="10,70,0,0" Width="200"/>
                            <Label x:Name="Track_Vel"  HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="40" Height="74" Margin="210,70,0,0" Width="200"/>
                            <Label  Content="X："  HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="40" Height="74" Margin="10,140,0,0" Width="200"/>
                            <Label x:Name="Track_X"   HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="40" Height="74" Margin="210,140,0,0" Width="200"/>
                            <Label  Content="Later_ERR：" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="40" Height="74" Margin="10,210,0,0" Width="200"/>
                            <Label x:Name="Track_Y" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="40" Height="74" Margin="210,210,0,0" Width="200"/>
                        </Grid>
                        <Canvas x:Name="Driver" Width="600">
                            <Canvas.Background>
                                <ImageBrush ImageSource="/assets/lane.png" Stretch="Uniform"/>
                            </Canvas.Background>
                            <Rectangle x:Name="LeftWarningArea" Fill="Transparent" Opacity="0.5"/>
                            <!-- 右侧红色警告区域 -->
                            <Rectangle x:Name="RightWarningArea" Fill="Transparent" Opacity="0.5"/>
                            <!-- 中间虚线（中心线） -->
                            <Line x:Name="CenterDashedLine"  Stroke="Yellow" StrokeThickness="2" StrokeDashArray="5,5"/>

                        </Canvas>
                    </StackPanel>



                </Grid>
            </TabItem>
            <TabItem Header="信息">
                <Grid>
                    <gmap:GMapControl x:Name="OfflineMap" Loaded="OfflineMap_Loaded" MouseWheelZoomType="MousePositionAndCenter" Margin="0"/>
                </Grid>
            </TabItem>

            <TabItem Header="轨迹图">
                <Grid Background="#FDFDFD">
                    <Border x:Name="TrajectoryPlotContainer" ClipToBounds="True" Background="Transparent">
                        <Canvas x:Name="PlotCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PlotScale" ScaleX="8" ScaleY="8"/>
                                    <TranslateTransform x:Name="PlotTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <Polyline x:Name="Polyline_VUT" Stroke="#FF4500" StrokeThickness="0.3" StrokeLineJoin="Round"/>
                            <Polyline x:Name="Polyline_SPT" Stroke="#1E90FF" StrokeThickness="0.3" StrokeLineJoin="Round"/>
                            <Polyline x:Name="Polyline_VT" Stroke="#32CD32" StrokeThickness="0.3" StrokeLineJoin="Round"/>

                            <Ellipse x:Name="Marker_VUT" Width="1" Height="1" Fill="#FF4500" Stroke="White" StrokeThickness="0.1" Visibility="Collapsed"/>
                            <Ellipse x:Name="Marker_SPT" Width="1" Height="1" Fill="#1E90FF" Stroke="White" StrokeThickness="0.1" Visibility="Collapsed"/>
                            <Ellipse x:Name="Marker_VT"  Width="1" Height="1" Fill="#32CD32" Stroke="White" StrokeThickness="0.1" Visibility="Collapsed"/>
                        </Canvas>
                    </Border>

                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15" Background="#80FFFFFF" Padding="10" CornerRadius="4">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="15" Height="4" Fill="#FF4500" VerticalAlignment="Center"/>
                                <TextBlock Text=" VUT (主车)" Margin="5,0,0,0" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="15" Height="4" Fill="#1E90FF" VerticalAlignment="Center"/>
                                <TextBlock Text=" SPT (目标车辆)" Margin="5,0,0,0" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="15" Height="4" Fill="#32CD32" VerticalAlignment="Center"/>
                                <TextBlock Text=" VT (远端设备)" Margin="5,0,0,0" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="15" Orientation="Vertical">

                        <Button x:Name="Btn_ResetPlot" Style="{StaticResource ButtonPrimary}" Content="回到中心" Width="100" Height="32" Margin="0,0,0,8"  HorizontalAlignment="Left" Click="Btn_ResetPlot_Click"/>

                        <TextBlock x:Name="Txt_PlotScaleInfo" Text="网格间距: 5m | 缩放倍率: 8.0x" 
                       HorizontalAlignment="Right" Foreground="#666666" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
